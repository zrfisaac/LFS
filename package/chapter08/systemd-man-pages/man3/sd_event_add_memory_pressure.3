.HP \w'int\ sd_event_add_io_pressure('u
.BI "int sd_event_add_io_pressure(sd_event\ *" "event" ", sd_event_source\ **" "ret_source" ", sd_event_handler_t\ " "handler" ", void\ *" "userdata" ");"
.HP \w'int\ sd_event_source_set_io_pressure_type('u
.BI "int sd_event_source_set_io_pressure_type(sd_event_source\ *" "source" ", const\ char\ *" "type" ");"
